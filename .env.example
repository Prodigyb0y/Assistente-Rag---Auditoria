# Copie para .env e preencha. NUNCA commite o .env.
# Em produção (Hugging Face Spaces), use os "secrets" da plataforma, não arquivo.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (confira os nomes atuais na documentação oficial antes de mudar)
OPENAI_MODEL=gpt-6.1-terra
ANTHROPIC_MODEL=claude-haiku-5-5
EMBEDDING_MODEL=text-embedding-3-small

# Teto rígido de gasto por provedor, em USD (orçamento total ~5 cada; margem de 1)
BUDGET_OPENAI_USD=4.0
BUDGET_ANTHROPIC_USD=4.0

# Chamadas
TIMEOUT_S=30
MAX_OUTPUT_TOKENS=512
# Limite de saída por chamada dos agentes (inclui tokens de raciocínio)
AGENT_MAX_OUTPUT_TOKENS=4096

# Orquestração: tentativas por provedor, espera exponencial (base * 2**(n-1), com teto),
# prazo por pergunta e confiança mínima aceita sem escalar (baixa | media | alta)
MAX_TENTATIVAS=3
ESPERA_BASE_S=1.0
ESPERA_MAX_S=8.0
PRAZO_TOTAL_S=120
CONFIANCA_MINIMA=media
# Modo de orquestração: escalonar (regra original) | adaptativo (padrão) | consenso (os dois sempre respondem)
ORQUESTRACAO_MODO=adaptativo
